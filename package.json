{
  "name": "oginstagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "vite build --config web/vite.config.ts && node tools/build-home.mjs",
    "lint": "eslint web/src shared",
    "check": "pnpm run lint && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && node --experimental-strip-types --test shared/routes.test.mjs web/src/preview-request.test.mjs && cd server && go test ./...",
    "image:build": "v=$(git describe --always --dirty --abbrev=8) && docker buildx build --platform linux/amd64 --build-arg OG_VERSION=$v -t oginstagram:$v --load . && echo oginstagram:$v",
    "deploy": "sh tools/deploy.sh",
    "backup": "sh tools/backup.sh"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@twemoji/parser": "15.0.0",
    "@twemoji/svg": "15.0.0",
    "echarts": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4"
  }
}
