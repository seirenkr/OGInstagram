{
  "name": "oginstagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "vite build --config web/vite.config.ts && node tools/build-home.mjs",
    "lint": "eslint web/src",
    "check": "pnpm run lint && tsc -p web/tsconfig.json --noEmit && node --experimental-strip-types --test shared/routes.test.mjs web/src/preview-request.test.mjs web/src/component-embed.test.mjs && { test ! -f harvest/verify.test.mjs || node --test harvest/verify.test.mjs; } && cd server && go test ./...",
    "image:build": "sh tools/image-build.sh"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "@phosphor-icons/react": "^2.1.10",
    "@twemoji/parser": "17.0.1",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
