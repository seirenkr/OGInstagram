# Tag loaded with docker load (oginstagram:<8-char commit hash>); see docs/vultr-deployment.md §2.
OG_IMAGE=oginstagram:local
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
BASE_URL=https://oginstagram.com
ALLOWED_HOSTS=oginstagram.com,www.oginstagram.com,d.oginstagram.com,g.oginstagram.com,www.d.oginstagram.com,www.g.oginstagram.com
# Exact cloudflared address from compose.yaml, never the entire Docker subnet.
TRUSTED_PROXIES=172.30.0.3
DEVELOPMENT=false
PROXY_USERNAME=
PROXY_PASSWORD=
# Generate a new JSON keyring, or explicitly reuse one. Single-quote JSON in this file.
OFFLOAD_SIGNING_KEYS=
WORKERHUB_SIGN_KEY=
WORKERHUB_SIGN_TS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_PURGE_TOKEN=
# Optional registered Discord custom emoji IDs. No icon is shown when unset.
DISCORD_BRAND_EMOJI_ID=
DISCORD_VERIFIED_EMOJI_ID=
# REQUIRED: first UTC date on which this deployment may consume proxy budget.
# Cold cutover: choose a future UTC day after the old Worker is stopped.
# Never move this date backward to bypass restored-state protection.
PROXY_BUDGET_START_DATE=
