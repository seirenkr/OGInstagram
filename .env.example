# Image loaded with docker load: oginstagram:<8-char commit hash>.
OG_IMAGE=oginstagram:local
# DataImpulse datacenter (DC) proxy credentials.
PROXY_USERNAME=
PROXY_PASSWORD=
# Cloudflare Turnstile widget for the home page preview.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Offload link keyring, required outside development. Key: openssl rand -base64 32 | tr '+/' '-_' | tr -d =
OFFLOAD_SIGNING_KEYS='{"active":"k1","keys":{"k1":"<key>"}}'
