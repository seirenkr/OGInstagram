{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oginstagram",
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-06-10",
  "dev": {
    "host": "localhost:8787",
    "port": 8787
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "BASE_URL": "https://oginstagram.com",
    "PROXY_HOURLY_LIMIT": "2500"
  },
  "routes": [
    {
      "pattern": "oginstagram.com",
      "custom_domain": true
    },
    {
      "pattern": "www.oginstagram.com",
      "custom_domain": true
    },
    {
      "pattern": "d.oginstagram.com",
      "custom_domain": true
    },
    {
      "pattern": "g.oginstagram.com",
      "custom_domain": true
    },
    {
      "pattern": "www.d.oginstagram.com",
      "custom_domain": true
    },
    {
      "pattern": "www.g.oginstagram.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OG_CONTAINER",
        "class_name": "OgUsContainer"
      }
    ]
  },
  "containers": [
    {
      "name": "oginstagram-us",
      "class_name": "OgUsContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "constraints": {
        "regions": ["ENAM"]
      },
      "max_instances": 3,
      "instance_type": "lite"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "AE",
      "dataset": "oginstagram_requests"
    }
  ],
  "ratelimits": [
    {
      "name": "EMBED_RATE_LIMITER",
      "namespace_id": "742901",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OgUsContainer"]
    }
  ]
}
